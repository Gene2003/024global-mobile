{
  "expo": {
    "name": "024 Global Connect",
    "slug": "024global-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "globalconnect024",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/628ed1aa-e596-447c-925a-7ebc9eca3511"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.global024.app",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.global024.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "024 Global Connect uses your location to auto-detect your farm and delivery locations, and to find nearby transporters."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "024 Global Connect needs access to your photos so you can add a clear picture of your produce to a listing.",
          "cameraPermission": "024 Global Connect needs camera access so you can take a photo of your produce for a listing."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "628ed1aa-e596-447c-925a-7ebc9eca3511"
      }
    }
  }
}
